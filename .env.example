# LLM Provider: groq | openai | gemini | ollama
PROVIDER=groq

# Модель (формат зависит от провайдера, см. README)
# Groq:  groq/llama-3.3-70b-versatile
# OpenAI: gpt-4o
# Gemini: gemini/gemini-1.5-pro
# Ollama: ollama/llama3
MODEL=groq/llama-3.3-70b-versatile

# --- Cloud API keys (заполнить нужный) ---
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_key_here
# GEMINI_API_KEY=your_gemini_key_here

# --- Ollama (локальные модели) ---
# OLLAMA_BASE_URL=http://localhost:11434

# Параметры генерации (опционально)
# TEMPERATURE=0.7
# MAX_TOKENS=512

# Порт WebSocket sidecar (опционально, по умолчанию 8765)
# WS_PORT=8765

# Путь к SQLite базе (опционально, по умолчанию sidecar/memory.db)
# MEMORY_DB_PATH=sidecar/memory.db
